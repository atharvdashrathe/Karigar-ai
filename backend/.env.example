# Copy this file to .env and adjust as needed. Never commit the real .env.

APP_NAME=Karigar AI
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# SQLite by default. Point this at a Postgres URL later without code changes.
DATABASE_URL=sqlite:///../data/karigar.db

MAX_UPLOAD_MB=15

# AI model selection & Gemini LLM API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
ASR_PRIMARY_MODEL=ai4bharat/indic-conformer-600m-multilingual
ARTISAN_ASR_MODEL=small
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
VISION_BG_REMOVAL_MODEL=u2netp

CORS_ALLOW_ORIGINS=*
